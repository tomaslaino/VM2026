# Kopiera till ".env" och fyll i dina nycklar. Committas aldrig.

# --- football-data.org (PRIMÄR – resultat, tabeller, schema) ---
# Gratis token: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=din_token_har
FD_COMPETITION=WC
FD_SEASON=2026

# Polling-intervall (sekunder)
FD_POLL_IDLE_SECONDS=900
FD_POLL_MATCHDAY_SECONDS=300
FD_POLL_LIVE_SECONDS=120

# --- Neon Postgres (valfritt – persistent lagring i molnet) ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- API-Football (valfritt – spelarstatistik) ---
API_FOOTBALL_KEY=
API_FOOTBALL_PROVIDER=direct
WC_LEAGUE_ID=1
WC_SEASON=2026

# --- Server ---
PORT=3000
OFFLINE_MODE=0
