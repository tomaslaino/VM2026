{
  "name": "vm2026",
  "version": "1.0.0",
  "description": "VM 2026 – grupper, slutspel & kalender med live-statistik via API-Football",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "sync": "node server/jobs/syncResults.js",
    "sync:static": "node server/scripts/syncStatic.js",
    "squads": "node server/jobs/fetchSquads.js",
    "live": "node server/jobs/livePoll.js",
    "finalize": "node server/jobs/finalize.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  }
}
