{
  "name": "vm2026",
  "version": "1.0.0",
  "description": "VM 2026 – grupper, slutspel & kalender med live-statistik via API-Football",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "sync": "node server/jobs/syncResults.js",
    "sync:static": "node server/scripts/syncStatic.js",
    "sync:status": "node server/scripts/syncPlayerStatus.js",
    "sync:availability": "node server/scripts/syncAvailability.js",
    "sync:news": "node server/scripts/syncTeamNews.js",
    "sync:lineups": "node server/scripts/syncLineups.js",
    "sync:metrics": "node server/scripts/syncPlayerMetrics.js",
    "sync:fotmob": "node server/scripts/syncFotmobRatings.js",
    "squads": "node server/jobs/fetchSquads.js",
    "live": "node server/jobs/livePoll.js",
    "finalize": "node server/jobs/finalize.js",
    "odds:sync": "node scripts/odds-agent/sync.mjs",
    "odds:agent": "node scripts/odds-agent/server.mjs",
    "odds:agent:start": "powershell -ExecutionPolicy Bypass -File scripts/odds-agent/start-agent.ps1",
    "odds:chrome": "powershell -ExecutionPolicy Bypass -File scripts/odds-agent/start-chrome.ps1 -Minimized",
    "odds:chrome:shortcut": "powershell -ExecutionPolicy Bypass -File scripts/odds-agent/create-shortcut.ps1",
    "odds:chrome:install": "powershell -ExecutionPolicy Bypass -File scripts/odds-agent/install-autostart.ps1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  }
}
